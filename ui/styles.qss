/* JARVIS HUD Theme — Dark Slate & Cyan Architecture */

QMainWindow, QWidget#CentralWidget {
    background-color: #0b0f19;
    color: #f8fafc;
    font-family: "Segoe UI", "Roboto", -apple-system, sans-serif;
    font-size: 13px;
}

/* Header Container */
QFrame#HeaderBar {
    background-color: #111827;
    border-bottom: 1px solid #1e293b;
    padding: 8px 16px;
}

QLabel#JarvisTitle {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #38bdf8;
}

QLabel#JarvisSubtitle {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    color: #64748b;
}

/* Badges */
QLabel#StatusBadgeOnline {
    background-color: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#StatusBadgeOffline {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#MeetingBadge {
    background-color: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* Buttons */
QPushButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #273549;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0f172a;
}

/* Action Header Buttons */
QPushButton#DashboardBtn {
    background-color: #132742;
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.5);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#DashboardBtn:hover {
    background-color: #1e3a5f;
    border-color: #38bdf8;
}

/* Audio Control Buttons */
QPushButton#MicBtnActive {
    background-color: #082f49;
    color: #38bdf8;
    border: 2px solid #38bdf8;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 700;
}

QPushButton#MicBtnMuted {
    background-color: #1e293b;
    color: #64748b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#MicBtnMuted:hover {
    background-color: #273549;
    color: #94a3b8;
}

QPushButton#TTSBtnActive {
    background-color: #0c4a6e;
    color: #7dd3fc;
    border: 2px solid #0284c7;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 700;
}

QPushButton#TTSBtnMuted {
    background-color: #1e293b;
    color: #64748b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#TTSBtnMuted:hover {
    background-color: #273549;
    color: #94a3b8;
}

/* Conversation Scroll Area */
QScrollArea#ChatScrollArea {
    background-color: #0b0f19;
    border: none;
}

QWidget#ChatContent {
    background-color: #0b0f19;
}

/* ScrollBar Styling */
QScrollBar:vertical {
    background-color: #0b0f19;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #334155;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #38bdf8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Message Bubbles */
QFrame#UserBubble {
    background-color: #0369a1;
    border: 1px solid #0284c7;
    border-radius: 12px;
    padding: 10px 14px;
}

QLabel#UserText {
    color: #f0fdf4;
    font-size: 13px;
    font-weight: 500;
}

QLabel#UserMeta {
    color: #bae6fd;
    font-size: 10px;
}

QFrame#JarvisBubble {
    background-color: #1e293b;
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 12px;
    padding: 12px 16px;
}

QLabel#JarvisText {
    color: #f8fafc;
    font-size: 13px;
    line-height: 1.4;
}

QLabel#JarvisMeta {
    color: #38bdf8;
    font-size: 10px;
    font-weight: 600;
}

/* Telemetry Dock / Stat Cards */
QFrame#TelemetryDock {
    background-color: #111827;
    border-left: 1px solid #1e293b;
    padding: 14px;
}

QFrame#StatCard {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 12px;
}

QFrame#StatCard:hover {
    border-color: rgba(56, 189, 248, 0.5);
}

QLabel#StatLabel {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#StatValue {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 700;
}

QLabel#StatSub {
    color: #38bdf8;
    font-size: 11px;
}

/* Upcoming Meeting Banner in Telemetry */
QFrame#MeetingCard {
    background-color: #162438;
    border: 1px solid #0284c7;
    border-radius: 10px;
    padding: 12px;
}

QLabel#MeetingCardTitle {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
}

QLabel#MeetingCardTime {
    color: #e2e8f0;
    font-size: 11px;
}

/* Input Bar */
QFrame#InputContainer {
    background-color: #111827;
    border-top: 1px solid #1e293b;
    padding: 12px 16px;
}

QLineEdit#CommandInput {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    selection-background-color: #0284c7;
}

QLineEdit#CommandInput:focus {
    border: 1px solid #38bdf8;
    background-color: #1a2538;
}

QPushButton#SubmitBtn {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#SubmitBtn:hover {
    background-color: #0369a1;
}

QPushButton#SubmitBtn:pressed {
    background-color: #075985;
}
