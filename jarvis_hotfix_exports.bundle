<file path="audio/voice_listener.py">
import time
import threading
from typing import Callable, Optional, Dict, Any, List

try:
    import speech_recognition as sr
except Exception:
    sr = None


class VoiceListener:
    """
    Thread-safe SpeechRecognition listener with lazy start (zero import-time threads),
    independent `mic_active` toggle, and meeting auto-mute interlock with manual user override.
    """

    def __init__(self, on_transcript: Optional[Callable[[str], None]] = None):
        self.on_transcript = on_transcript
        self.mic_active: bool = False
        self.in_meeting: bool = False
        self.in_meeting_auto_muted: bool = False
        self._pre_meeting_mic_state: bool = False
        self.status_detail: str = "Standby"
        self._stop_event = threading.Event()
        self._worker_thread: Optional[threading.Thread] = None
        self._lock = threading.RLock()
        self._state_listeners: List[Callable[[Dict[str, Any]], None]] = []

    def set_callback(self, callback: Callable[[str], None]) -> None:
        self.on_transcript = callback

    def register_state_listener(self, cb: Callable[[Dict[str, Any]], None]) -> None:
        if cb not in self._state_listeners:
            self._state_listeners.append(cb)

    def get_state(self) -> Dict[str, Any]:
        return {
            "mic_active": self.mic_active,
            "in_meeting": self.in_meeting,
            "in_meeting_auto_muted": self.in_meeting_auto_muted,
            "status_detail": self.status_detail,
        }

    def _notify(self) -> None:
        state = self.get_state()
        for cb in list(self._state_listeners):
            try:
                cb(state)
            except Exception:
                pass

    def start_background(self, callback: Optional[Callable[[str], None]] = None) -> None:
        if callback is not None:
            self.on_transcript = callback
        self.ensure_worker_started()

    def ensure_worker_started(self) -> None:
        with self._lock:
            if self._worker_thread is not None and self._worker_thread.is_alive():
                return
            self._stop_event.clear()
            self._worker_thread = threading.Thread(target=self._listen_loop, daemon=True)
            self._worker_thread.start()

    def toggle_mic(self, active: Optional[bool] = None) -> bool:
        with self._lock:
            target = (not self.mic_active) if active is None else bool(active)
            self.set_mic_active(target, manual_override=True)
            return self.mic_active

    def set_mic_active(self, active: bool, manual_override: bool = True) -> Dict[str, Any]:
        with self._lock:
            self.mic_active = bool(active)
            if manual_override and active:
                self.in_meeting_auto_muted = False
            self.status_detail = "Listening" if self.mic_active else "Muted"
            if self.mic_active:
                self.ensure_worker_started()
            self._notify()
            return self.get_state()

    def enter_meeting_auto_mute(self) -> Dict[str, Any]:
        """Auto-mutes JARVIS mic when joining a meeting; user can still manually unmute anytime."""
        with self._lock:
            self._pre_meeting_mic_state = self.mic_active
            self.in_meeting = True
            self.in_meeting_auto_muted = True
            self.mic_active = False
            self.status_detail = "Auto-Muted (In Meeting)"
            self._notify()
            return self.get_state()

    def on_meeting_start(self) -> Dict[str, Any]:
        return self.enter_meeting_auto_mute()

    def on_meeting_end(self) -> Dict[str, Any]:
        with self._lock:
            self.in_meeting = False
            self.in_meeting_auto_muted = False
            self.status_detail = "Listening" if self.mic_active else "Muted"
            self._notify()
            return self.get_state()

    def stop(self) -> None:
        self.shutdown()

    def shutdown(self) -> None:
        self._stop_event.set()
        self.mic_active = False

    def _listen_loop(self) -> None:
        if sr is None:
            self.status_detail = "SpeechRecognition Unavailable"
            self._notify()
            return

        recognizer = sr.Recognizer()
        recognizer.dynamic_energy_threshold = True

        while not self._stop_event.is_set():
            if not self.mic_active:
                time.sleep(0.25)
                continue

            try:
                with sr.Microphone() as source:
                    audio = recognizer.listen(source, timeout=3.0, phrase_time_limit=10.0)
                if not self.mic_active:
                    continue
                text = recognizer.recognize_google(audio).strip()
                if text and self.on_transcript:
                    self.on_transcript(text)
            except Exception:
                time.sleep(0.2)


# Module-level singleton (lazy: does NOT spawn threads on import)
voice_listener = VoiceListener()
</file>

<file path="agent_os/os_actuator.py">
import time
import threading
from typing import Optional, Callable, Dict, Any

try:
    import pyautogui
    pyautogui.FAILSAFE = True
    pyautogui.PAUSE = 0.05
    PYAUTOGUI_AVAILABLE = True
except Exception:
    pyautogui = None
    PYAUTOGUI_AVAILABLE = False

try:
    from pynput import keyboard
    PYNPUT_AVAILABLE = True
except Exception:
    keyboard = None
    PYNPUT_AVAILABLE = False


class OSActuator:
    """
    Tier 3 OS GUI Actuator with strictly task-scoped [ESC] emergency kill-switch.
    Never registers a global WH_KEYBOARD_LL hook at module import time.
    """

    def __init__(self, on_abort_callback: Optional[Callable[[], None]] = None):
        self._abort_event = threading.Event()
        self._listener: Optional[Any] = None
        self._lock = threading.Lock()
        self._on_abort_callback = on_abort_callback

    @property
    def is_aborted(self) -> bool:
        return self._abort_event.is_set()

    @property
    def aborted(self) -> bool:
        return self._abort_event.is_set()

    def reset_abort(self) -> None:
        self._abort_event.clear()

    def reset(self) -> None:
        self._abort_event.clear()

    def trigger_abort(self) -> None:
        self._abort_event.set()
        if self._on_abort_callback:
            try:
                self._on_abort_callback()
            except Exception:
                pass

    def abort(self) -> None:
        self.trigger_abort()

    def start_esc_guard(self) -> None:
        """Starts the low-level [ESC] listener ONLY while an active OS Agent task is running."""
        with self._lock:
            self._abort_event.clear()
            if keyboard is None or self._listener is not None:
                return

            def _on_press(key):
                try:
                    if key == keyboard.Key.esc:
                        self.trigger_abort()
                        return False
                except Exception:
                    pass
                return True

            self._listener = keyboard.Listener(on_press=_on_press)
            self._listener.daemon = True
            self._listener.start()

    def stop_esc_guard(self) -> None:
        """Unhooks WH_KEYBOARD_LL immediately when the OS Agent task finishes."""
        with self._lock:
            if self._listener is not None:
                try:
                    self._listener.stop()
                except Exception:
                    pass
                self._listener = None

    def click(self, x: int, y: int, button: str = "left", clicks: int = 1) -> Dict[str, Any]:
        return self.execute_action({"action": "click", "x": x, "y": y, "button": button, "clicks": clicks})

    def type_text(self, text: str, press_enter: bool = False, x: Optional[int] = None, y: Optional[int] = None) -> Dict[str, Any]:
        payload: Dict[str, Any] = {"action": "type", "text": text, "press_enter": press_enter}
        if x is not None and y is not None:
            payload["x"] = x
            payload["y"] = y
        return self.execute_action(payload)

    def hotkey(self, *keys: str) -> Dict[str, Any]:
        return self.execute_action({"action": "hotkey", "keys": list(keys)})

    def execute_action(self, action: Dict[str, Any]) -> Dict[str, Any]:
        if self.is_aborted:
            return {"status": "aborted", "success": False, "detail": "Emergency [ESC] kill-switch triggered."}

        act_type = str(action.get("action", action.get("type", ""))).lower().strip()
        if act_type in ("done", "complete", "finish"):
            return {"status": "done", "success": True, "detail": action.get("reason", "Goal achieved.")}

        if act_type == "wait":
            seconds = float(action.get("seconds", 1.0))
            time.sleep(min(seconds, 10.0))
            return {"status": "ok", "success": True, "detail": f"Waited {seconds}s"}

        if pyautogui is None:
            return {"status": "simulated", "success": True, "detail": f"Simulated {act_type} (PyAutoGUI unavailable)"}

        try:
            if act_type == "click":
                x = int(action.get("x", 0))
                y = int(action.get("y", 0))
                button = str(action.get("button", "left"))
                clicks = int(action.get("clicks", 1))
                pyautogui.click(x=x, y=y, clicks=clicks, button=button)
                return {"status": "ok", "success": True, "detail": f"Clicked ({x}, {y}) [{button} x{clicks}]"}

            elif act_type == "double_click":
                x = int(action.get("x", 0))
                y = int(action.get("y", 0))
                pyautogui.doubleClick(x=x, y=y)
                return {"status": "ok", "success": True, "detail": f"Double-clicked ({x}, {y})"}

            elif act_type in ("type", "type_text"):
                text = str(action.get("text", ""))
                press_enter = bool(action.get("press_enter", False))
                if "x" in action and "y" in action and action["x"] is not None and action["y"] is not None:
                    pyautogui.click(x=int(action["x"]), y=int(action["y"]))
                    time.sleep(0.1)
                pyautogui.write(text, interval=0.02)
                if press_enter:
                    pyautogui.press("enter")
                return {"status": "ok", "success": True, "detail": f"Typed {len(text)} chars"}

            elif act_type == "hotkey":
                keys = action.get("keys", [])
                if isinstance(keys, str):
                    keys = [k.strip() for k in keys.split("+") if k.strip()]
                pyautogui.hotkey(*keys)
                return {"status": "ok", "success": True, "detail": f"Hotkey {'+'.join(keys)}"}

            elif act_type == "scroll":
                amount = int(action.get("amount", -300))
                pyautogui.scroll(amount)
                return {"status": "ok", "success": True, "detail": f"Scrolled {amount}"}

            return {"status": "error", "success": False, "detail": f"Unknown OS action type: {act_type}"}
        except Exception as exc:
            return {"status": "error", "success": False, "detail": f"Actuator exception: {exc}"}


# Module-level singleton (does NOT start pynput listener on import)
os_actuator = OSActuator()
</file>

<file path="agent_os/state_machine.py">
import sys
import json
import subprocess
import threading
from pathlib import Path
from typing import Callable, List, Dict, Any, Optional

from agent_os.os_actuator import os_actuator
from agent_os.safety_interceptor import safety_interceptor as default_safety_interceptor

BASE_DIR = Path(__file__).resolve().parent.parent


class OSAgentStateMachine:
    """
    Tier 3 OS Agent Supervisor.
    Spawns `agent_os/worker_proc.py` in a child Python process so COM/UIA/mss/pynput
    never block the FastAPI asyncio loop or share the main process GIL.
    """

    def __init__(self, safety_interceptor: Optional[Any] = None, max_steps: int = 8):
        self.safety_interceptor = safety_interceptor or default_safety_interceptor
        self.max_steps = max_steps
        self._step_listeners: List[Callable[[Dict[str, Any]], None]] = []
        self._active_proc: Optional[subprocess.Popen] = None
        self._proc_lock = threading.Lock()
        self.running: bool = False

    def register_step_listener(self, callback: Callable[[Dict[str, Any]], None]) -> None:
        if callback not in self._step_listeners:
            self._step_listeners.append(callback)

    def _emit_step(self, payload: Dict[str, Any]) -> None:
        for cb in list(self._step_listeners):
            try:
                cb(payload)
            except Exception:
                pass

    def abort(self) -> bool:
        return self.abort_current_task()

    def abort_current_task(self) -> bool:
        os_actuator.trigger_abort()
        with self._proc_lock:
            self.running = False
            if self._active_proc and self._active_proc.poll() is None:
                try:
                    self._active_proc.terminate()
                    self._active_proc.wait(timeout=2.0)
                except Exception:
                    try:
                        self._active_proc.kill()
                    except Exception:
                        pass
                self._active_proc = None
                self._emit_step(
                    {
                        "tier": "TIER_3_VISION",
                        "phase": "ABORTED",
                        "message": "OS Agent subprocess terminated by user abort.",
                    }
                )
                return True
        return False

    def run_goal(self, goal: str, max_steps: Optional[int] = None) -> Dict[str, Any]:
        return self.execute_goal(goal=goal, max_steps=max_steps or self.max_steps)

    def execute_goal(self, goal: str, max_steps: int = 8) -> Dict[str, Any]:
        if self.safety_interceptor is not None:
            if hasattr(self.safety_interceptor, "check_and_request_approval"):
                approved, reason = self.safety_interceptor.check_and_request_approval(
                    tier="TIER_3_VISION", command_desc=goal
                )
                if not approved:
                    msg = f"Action blocked by Safety Interceptor: {reason}"
                    self._emit_step({"tier": "TIER_3_VISION", "phase": "BLOCKED", "message": msg})
                    return {"status": "blocked", "success": False, "summary": msg}
            elif hasattr(self.safety_interceptor, "evaluate_command"):
                check = self.safety_interceptor.evaluate_command(goal, tier="TIER_3_VISION")
                if isinstance(check, dict) and check.get("blocked"):
                    msg = f"Action blocked by Safety Interceptor: {check.get('reason', 'Restricted')}"
                    self._emit_step({"tier": "TIER_3_VISION", "phase": "BLOCKED", "message": msg})
                    return {"status": "blocked", "success": False, "summary": msg}

        self.abort_current_task()
        os_actuator.reset_abort()

        cmd = [sys.executable, "-m", "agent_os.worker_proc"]
        final_result: Dict[str, Any] = {
            "status": "completed",
            "success": True,
            "summary": "OS Agent task finished.",
        }

        with self._proc_lock:
            self.running = True
            self._active_proc = subprocess.Popen(
                cmd,
                cwd=str(BASE_DIR),
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                encoding="utf-8",
                bufsize=1,
            )
            proc = self._active_proc

        try:
            assert proc.stdin is not None
            assert proc.stdout is not None
            proc.stdin.write(json.dumps({"goal": goal, "max_steps": max_steps}) + "\n")
            proc.stdin.flush()
            proc.stdin.close()

            for raw_line in proc.stdout:
                line = raw_line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except Exception:
                    continue

                ev = msg.get("event")
                payload = msg.get("payload", {})
                if ev == "AGENT_STEP":
                    self._emit_step(payload)
                elif ev == "RESULT":
                    final_result = payload
                    final_result.setdefault("success", final_result.get("status") == "completed")

            proc.wait(timeout=5.0)
        except Exception as exc:
            final_result = {"status": "error", "success": False, "summary": f"OS Agent supervisor error: {exc}"}
        finally:
            with self._proc_lock:
                self.running = False
                if self._active_proc is proc:
                    self._active_proc = None

        return final_result


# Backward-compatible class alias and singleton export
OSStateMachine = OSAgentStateMachine
os_agent = OSAgentStateMachine()
