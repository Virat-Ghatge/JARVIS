<file path="agent_os/worker_proc.py">
import sys
import json
import time
import traceback
from typing import Dict, Any

from agent_os.os_actuator import OSActuator
from agent_os.ui_distiller import UIDistiller
from agent_os.som_vision import SoMVision
from core.llm_router import LLMRouter
from core.adapters.base import extract_json_from_text


def emit_event(event_type: str, payload: Dict[str, Any]) -> None:
    line = json.dumps({"event": event_type, "payload": payload}, ensure_ascii=False)
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def run_worker_loop(goal: str, max_steps: int = 8) -> None:
    router = LLMRouter()
    distiller = UIDistiller()
    som = SoMVision()
    actuator = OSActuator(
        on_abort_callback=lambda: emit_event(
            "AGENT_STEP",
            {
                "tier": "TIER_3_VISION",
                "phase": "ABORTED",
                "message": "Emergency [ESC] kill-switch pressed by user.",
                "timestamp": time.time(),
            },
        )
    )

    actuator.start_esc_guard()
    try:
        emit_event(
            "AGENT_STEP",
            {
                "tier": "TIER_3_VISION",
                "phase": "OBSERVE",
                "message": f"Starting isolated OS Agent worker for goal: {goal}",
                "timestamp": time.time(),
            },
        )

        history = []
        for step_idx in range(1, max_steps + 1):
            if actuator.is_aborted:
                emit_event("RESULT", {"status": "aborted", "summary": "Task aborted via [ESC]."})
                return

            ui_elements = distiller.extract_interactive_elements()
            som_snapshot = som.capture_and_annotate(ui_elements)

            emit_event(
                "AGENT_STEP",
                {
                    "tier": "TIER_3_VISION",
                    "phase": "THINK",
                    "step": step_idx,
                    "elements_count": len(ui_elements),
                    "screenshot_b64": som_snapshot.get("image_b64", ""),
                    "message": f"Step {step_idx}: Distilled {len(ui_elements)} interactive UI elements.",
                    "timestamp": time.time(),
                },
            )

            prompt = (
                f"You are the JARVIS Tier 3 OS GUI Agent.\n"
                f"User Goal: {goal}\n"
                f"Current Step: {step_idx}/{max_steps}\n"
                f"Previous Steps: {json.dumps(history[-4:])}\n"
                f"Visible UI Elements (Set-of-Mark IDs with center coordinates):\n"
                f"{json.dumps(ui_elements[:60], ensure_ascii=False)}\n\n"
                "Respond ONLY with a valid JSON object matching one of:\n"
                '{"action": "click", "x": 120, "y": 340, "reason": "..."}\n'
                '{"action": "type", "x": 120, "y": 340, "text": "...", "press_enter": true, "reason": "..."}\n'
                '{"action": "hotkey", "keys": ["ctrl", "l"], "reason": "..."}\n'
                '{"action": "wait", "seconds": 1.5, "reason": "..."}\n'
                '{"action": "done", "reason": "Goal completed"}'
            )

            raw_reply = router.generate(
                role="vision_agent",
                prompt=prompt,
                image_b64=som_snapshot.get("image_b64"),
            )
            decision = extract_json_from_text(raw_reply) or {"action": "done", "reason": str(raw_reply)}

            if str(decision.get("action", "")).lower() in ("done", "complete", "finish"):
                emit_event(
                    "AGENT_STEP",
                    {
                        "tier": "TIER_3_VISION",
                        "phase": "VERIFY",
                        "step": step_idx,
                        "message": decision.get("reason", "OS Agent task complete."),
                        "timestamp": time.time(),
                    },
                )
                emit_event(
                    "RESULT",
                    {"status": "completed", "summary": decision.get("reason", "Task completed.")},
                )
                return

            emit_event(
                "AGENT_STEP",
                {
                    "tier": "TIER_3_VISION",
                    "phase": "ACT",
                    "step": step_idx,
                    "action": decision,
                    "message": decision.get("reason", f"Executing {decision.get('action')}"),
                    "timestamp": time.time(),
                },
            )

            outcome = actuator.execute_action(decision)
            history.append({"step": step_idx, "decision": decision, "outcome": outcome})
            time.sleep(0.45)

        emit_event(
            "RESULT",
            {"status": "max_steps", "summary": f"Reached maximum steps ({max_steps}) for goal: {goal}"},
        )
    except Exception as exc:
        emit_event(
            "RESULT",
            {
                "status": "error",
                "summary": f"OS Agent worker failed: {exc}",
                "trace": traceback.format_exc(),
            },
        )
    finally:
        actuator.stop_esc_guard()


if __name__ == "__main__":
    raw_in = sys.stdin.readline()
    params = json.loads(raw_in) if raw_in.strip() else {}
    run_worker_loop(
        goal=params.get("goal", ""),
        max_steps=int(params.get("max_steps", 8)),
    )
</file>

<file path="agent_os/state_machine.py">
import sys
import json
import subprocess
import threading
from pathlib import Path
from typing import Callable, List, Dict, Any, Optional

BASE_DIR = Path(__file__).resolve().parent.parent


class OSAgentStateMachine:
    """
     Tier 3 OS Agent Supervisor.
    Spawns `agent_os/worker_proc.py` in a child Python process so COM/UIA/mss/pynput
    never block the FastAPI asyncio loop or share the main process GIL.
    """

    def __init__(self, safety_interceptor: Optional[Any] = None):
        self.safety_interceptor = safety_interceptor
        self._step_listeners: List[Callable[[Dict[str, Any]], None]] = []
        self._active_proc: Optional[subprocess.Popen] = None
        self._proc_lock = threading.Lock()

    def register_step_listener(self, callback: Callable[[Dict[str, Any]], None]) -> None:
        if callback not in self._step_listeners:
            self._step_listeners.append(callback)

    def _emit_step(self, payload: Dict[str, Any]) -> None:
        for cb in list(self._step_listeners):
            try:
                cb(payload)
            except Exception:
                pass

    def abort_current_task(self) -> bool:
        with self._proc_lock:
            if self._active_proc and self._active_proc.poll() is None:
                try:
                    self._active_proc.terminate()
                    self._active_proc.wait(timeout=2.0)
                except Exception:
                    try:
                        self._active_proc.kill()
                    except Exception:
                        pass
                self._active_proc = None
                self._emit_step(
                    {
                        "tier": "TIER_3_VISION",
                        "phase": "ABORTED",
                        "message": "OS Agent subprocess terminated by user abort.",
                    }
                )
                return True
        return False

    def execute_goal(self, goal: str, max_steps: int = 8) -> Dict[str, Any]:
        if self.safety_interceptor is not None:
            approved, reason = self.safety_interceptor.check_and_request_approval(
                tier="TIER_3_VISION", command_desc=goal
            )
            if not approved:
                msg = f"Action blocked by Safety Interceptor: {reason}"
                self._emit_step({"tier": "TIER_3_VISION", "phase": "BLOCKED", "message": msg})
                return {"status": "blocked", "summary": msg}

        self.abort_current_task()

        cmd = [sys.executable, "-m", "agent_os.worker_proc"]
        final_result: Dict[str, Any] = {"status": "completed", "summary": "OS Agent task finished."}

        with self._proc_lock:
            self._active_proc = subprocess.Popen(
                cmd,
                cwd=str(BASE_DIR),
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                encoding="utf-8",
                bufsize=1,
            )
            proc = self._active_proc

        try:
            assert proc.stdin is not None
            assert proc.stdout is not None
            proc.stdin.write(json.dumps({"goal": goal, "max_steps": max_steps}) + "\n")
            proc.stdin.flush()
            proc.stdin.close()

            for raw_line in proc.stdout:
                line = raw_line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except Exception:
                    continue

                ev = msg.get("event")
                payload = msg.get("payload", {})
                if ev == "AGENT_STEP":
                    self._emit_step(payload)
                elif ev == "RESULT":
                    final_result = payload

            proc.wait(timeout=5.0)
        except Exception as exc:
            final_result = {"status": "error", "summary": f"OS Agent supervisor error: {exc}"}
        finally:
            with self._proc_lock:
                if self._active_proc is proc:
                    self._active_proc = None

        return final_result
</file>

<file path="automation/meeting_worker.py">
import sys
import json
import time
import threading
import traceback
from pathlib import Path
from typing import Dict, Any, List

from config.settings import BROWSER_PROFILE_DIR

_command_state = {"leave_requested": False, "setup_mode": False}


def emit(event_type: str, payload: Dict[str, Any]) -> None:
    sys.stdout.write(json.dumps({"event": event_type, "payload": payload}, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def _stdin_watcher() -> None:
    for line in sys.stdin:
        raw = line.strip()
        if not raw:
            continue
        try:
            cmd = json.loads(raw)
            if cmd.get("command") == "leave":
                _command_state["leave_requested"] = True
                break
        except Exception:
            continue


def _mute_and_join_google_meet(page: Any) -> None:
    time.sleep(2.5)
    for hotkey in ("Control+d", "Control+e"):
        try:
            page.keyboard.press(hotkey)
            time.sleep(0.3)
        except Exception:
            pass

    join_selectors = [
        "button:has-text('Join now')",
        "button:has-text('Ask to join')",
        "button:has-text('Switch here')",
    ]
    for sel in join_selectors:
        try:
            loc = page.locator(sel).first
            if loc.is_visible(timeout=1500):
                loc.click()
                break
        except Exception:
            continue


def _mute_and_join_teams(page: Any) -> None:
    time.sleep(3.0)
    join_selectors = [
        "button:has-text('Join now')",
        "button[data-tid='prejoin-join-button']",
    ]
    for sel in join_selectors:
        try:
            loc = page.locator(sel).first
            if loc.is_visible(timeout=2000):
                loc.click()
                break
        except Exception:
            continue


def _scrape_live_captions(page: Any, transcript_log: List[Dict[str, str]], seen_lines: set) -> None:
    selectors = [
        "div[jscontroller] span",
        "[ data-tid='closed-captions-renderer'] span",
        ".iOzk7",
        ".a4cQT",
    ]
    for sel in selectors:
        try:
            nodes = page.locator(sel).all_inner_texts()
            for text in nodes[-6:]:
                cleaned = " ".join(text.strip().split())
                if len(cleaned) > 4 and cleaned not in seen_lines:
                    seen_lines.add(cleaned)
                    entry = {"timestamp": time.strftime("%H:%M:%S"), "text": cleaned}
                    transcript_log.append(entry)
                    emit("CAPTION", entry)
        except Exception:
            continue


def run_meeting_session(config: Dict[str, Any]) -> None:
    url = config.get("url", "https://accounts.google.com")
    meeting_id = config.get("meeting_id", f"mtg_{int(time.time())}")
    title = config.get("title", "Live Meeting")
    setup_only = bool(config.get("setup_only", False))

    watcher = threading.Thread(target=_stdin_watcher, daemon=True)
    watcher.start()

    transcript_log: List[Dict[str, str]] = []
    seen_lines: set = set()

    try:
        from playwright.sync_api import sync_playwright
    except Exception as exc:
        emit("ERROR", {"meeting_id": meeting_id, "error": f"Playwright import failed: {exc}"})
        return

    try:
        with sync_playwright() as p:
            BROWSER_PROFILE_DIR.mkdir(parents=True, exist_ok=True)
            context = p.chromium.launch_persistent_context(
                user_data_dir=str(BROWSER_PROFILE_DIR),
                headless=False,
                args=[
                    "--use-fake-ui-for-media-stream",
                    "--disable-notifications",
                    "--mute-audio",
                ],
            )
            page = context.pages[0] if context.pages else context.new_page()
            page.goto(url, wait_until="domcontentloaded", timeout=45000)

            emit(
                "STATUS",
                {
                    "status": "setup" if setup_only else "in_meeting",
                    "meeting_id": meeting_id,
                    "title": title,
                    "url": url,
                },
            )

            if not setup_only:
                if "meet.google.com" in url:
                    _mute_and_join_google_meet(page)
                elif "teams.microsoft.com" in url or "teams.live.com" in url:
                    _mute_and_join_teams(page)

            while not _command_state["leave_requested"]:
                if page.is_closed():
                    break
                if not setup_only:
                    _scrape_live_captions(page, transcript_log, seen_lines)
                time.sleep(1.5)

            try:
                context.close()
            except Exception:
                pass

        emit(
            "FINISHED",
            {
                "meeting_id": meeting_id,
                "title": title,
                "url": url,
                "setup_only": setup_only,
                "transcript": transcript_log,
            },
        )
    except Exception as exc:
        emit(
            "ERROR",
            {
                "meeting_id": meeting_id,
                "title": title,
                "error": str(exc),
                "trace": traceback.format_exc(),
                "transcript": transcript_log,
            },
        )


if __name__ == "__main__":
    first_line = sys.stdin.readline()
    cfg = json.loads(first_line) if first_line.strip() else {}
    run_meeting_session(cfg)
</file>

<file path="automation/meeting_bot.py">
import sys
import json
import time
import threading
import subprocess
from datetime import datetime
from typing import Callable, Dict, Any, List, Optional

from config.settings import BASE_DIR, SUMMARIES_PATH, ensure_json_file


class MeetingBot:
    """
    Subprocess-isolated Meeting Bot supervisor.
    Launches `automation.meeting_worker` in its own Python process so sync_playwright
    greenlets never collide with FastAPI/uvicorn or freeze the main process.
    """

    def __init__(self, llm_router: Optional[Any] = None, voice_listener: Optional[Any] = None):
        self.llm_router = llm_router
        self.voice_listener = voice_listener
        self._state_listeners: List[Callable[[Dict[str, Any]], None]] = []
        self._proc: Optional[subprocess.Popen] = None
        self._lock = threading.RLock()
        self._current_state: Dict[str, Any] = {
            "status": "idle",
            "meeting_id": None,
            "title": None,
            "url": None,
            "captions": [],
            "mic_auto_muted": False,
        }
        ensure_json_file(SUMMARIES_PATH, [])

    def register_state_listener(self, callback: Callable[[Dict[str, Any]], None]) -> None:
        if callback not in self._state_listeners:
            self._state_listeners.append(callback)

    def _broadcast_state(self) -> None:
        snapshot = dict(self._current_state)
        for cb in list(self._state_listeners):
            try:
                cb(snapshot)
            except Exception:
                pass

    def get_state(self) -> Dict[str, Any]:
        with self._lock:
            return dict(self._current_state)

    def open_login_setup(self, url: str = "https://accounts.google.com") -> Dict[str, Any]:
        return self.join_meeting(
            url=url,
            meeting_id="browser_profile_setup",
            title="Browser Profile Login Setup",
            setup_only=True,
        )

    def join_meeting(
        self,
        url: str,
        meeting_id: Optional[str] = None,
        title: str = "Instant Meeting",
        setup_only: bool = False,
    ) -> Dict[str, Any]:
        with self._lock:
            if self._proc and self._proc.poll() is None:
                return {"status": "busy", "message": "Meeting bot is already active.", "state": self.get_state()}

            mid = meeting_id or f"mtg_{int(time.time())}"

            # Auto-mute JARVIS listening microphone on meeting join while still allowing manual user unmute
            auto_muted = False
            if not setup_only and self.voice_listener is not None:
                try:
                    if hasattr(self.voice_listener, "enter_meeting_auto_mute"):
                        self.voice_listener.enter_meeting_auto_mute()
                    elif hasattr(self.voice_listener, "set_mic_active"):
                        self.voice_listener.set_mic_active(False)
                    auto_muted = True
                except Exception:
                    pass

            self._current_state = {
                "status": "joining",
                "meeting_id": mid,
                "title": title,
                "url": url,
                "captions": [],
                "mic_auto_muted": auto_muted,
            }
            self._broadcast_state()

            proc = subprocess.Popen(
                [sys.executable, "-m", "automation.meeting_worker"],
                cwd=str(BASE_DIR),
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                encoding="utf-8",
                bufsize=1,
            )
            self._proc = proc

            assert proc.stdin is not None
            proc.stdin.write(
                json.dumps(
                    {
                        "url": url,
                        "meeting_id": mid,
                        "title": title,
                        "setup_only": setup_only,
                    }
                )
                + "\n"
            )
            proc.stdin.flush()

            monitor = threading.Thread(target=self._monitor_worker, args=(proc,), daemon=True)
            monitor.start()

            return {"status": "started", "meeting_id": mid, "state": self.get_state()}

    def leave_meeting(self) -> Dict[str, Any]:
        with self._lock:
            proc = self._proc
            if not proc or proc.poll() is None is False:
                self._current_state["status"] = "idle"
                self._broadcast_state()
                return {"status": "idle", "message": "No active meeting session."}

            try:
                if proc.stdin:
                    proc.stdin.write(json.dumps({"command": "leave"}) + "\n")
                    proc.stdin.flush()
            except Exception:
                try:
                    proc.terminate()
                except Exception:
                    pass

        return {"status": "leaving", "state": self.get_state()}

    def _monitor_worker(self, proc: subprocess.Popen) -> None:
        try:
            assert proc.stdout is not None
            for raw_line in proc.stdout:
                line = raw_line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except Exception:
                    continue

                ev = msg.get("event")
                payload = msg.get("payload", {})

                if ev == "STATUS":
                    with self._lock:
                        self._current_state["status"] = payload.get("status", "in_meeting")
                        self._broadcast_state()
                elif ev == "CAPTION":
                    with self._lock:
                        caps = self._current_state.get("captions", [])
                        caps.append(payload)
                        self._current_state["captions"] = caps[-100:]
                        self._broadcast_state()
                elif ev == "FINISHED":
                    self._handle_post_call(payload)
                elif ev == "ERROR":
                    with self._lock:
                        self._current_state["status"] = "error"
                        self._current_state["error"] = payload.get("error", "Unknown meeting worker error")
                        self._broadcast_state()
        finally:
            with self._lock:
                if self._proc is proc:
                    self._proc = None
                self._current_state["status"] = "idle"
                self._current_state["mic_auto_muted"] = False
                self._broadcast_state()

    def _handle_post_call(self, payload: Dict[str, Any]) -> None:
        if payload.get("setup_only"):
            return

        transcript_items = payload.get("transcript", [])
        full_text = "\n".join(f"[{c.get('timestamp', '')}] {c.get('text', '')}" for c in transcript_items)
        summary_text = "No live captions were captured during this session."

        if full_text.strip() and self.llm_router is not None:
            try:
                prompt = (
                    "Summarize the following meeting transcript with:\n"
                    "1. Executive Summary\n2. Key Decisions\n3. Action Items\n\n"
                    f"Transcript:\n{full_text[:12000]}"
                )
                summary_text = self.llm_router.generate(role="meeting_summarizer", prompt=prompt)
            except Exception as exc:
                summary_text = f"Automated summary generation failed: {exc}"

        record = {
            "id": f"sum_{int(time.time())}",
            "meeting_id": payload.get("meeting_id"),
            "title": payload.get("title", "Meeting"),
            "url": payload.get("url", ""),
            "ended_at": datetime.now().isoformat(),
            "captions_count": len(transcript_items),
            "summary": summary_text,
            "transcript": transcript_items,
        }

        try:
            with open(SUMMARIES_PATH, "r", encoding="utf-8") as f:
                summaries = json.load(f)
        except Exception:
            summaries = []

        summaries.insert(0, record)
        with open(SUMMARIES_PATH, "w", encoding="utf-8") as f:
            json.dump(summaries[:100], f, indent=2)

    def list_summaries(self) -> List[Dict[str, Any]]:
        try:
            with open(SUMMARIES_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return []
